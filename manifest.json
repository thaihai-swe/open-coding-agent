{
  "name": "corezero",
  "version": "1.0.0",
  "requires_python": ">=3.10",
  "description": "Skills-first spec-driven delivery kit. Harness and context compiler are layers inside it; install is copy-with-seed, not a starter template.",
  "homepage": "https://github.com/thaihai-swe/CoreZero",
  "files": {
    "overwrite": [
      "manifest.json",
      "README.md",
      "AGENTS.md",
      "EXTERNAL_SKILLS.md",
      "skills/README.md",
      "skills/_shared/**",
      "skills/context-memory/**",
      "skills/harness-maintain/**",
      "skills/harness-verify/**",
      "skills/spec-adr/**",
      "skills/spec-implement/**",
      "skills/spec-plan/**",
      "skills/spec-requirements/**",
      "skills/spec-research/**",
      "skills/spec-tasks/**",
      "skills/spec-testing-scenario/**",
      "skills/starter-init/**",
      "references/context-routes.yaml",
      "references/tool-providers-registry.json",
      "core-zero/scripts/core/**",
      "core-zero/scripts/install.sh",
      "core-zero/rules/**",
      "core-zero/CONTEXT_AND_MEMORY.md",
      "core-zero/project/state-machine.yaml",
      "core-zero/scripts/validate-skill-consistency.py",
      "core-zero/scripts/validate-static-audit.py"
    ],
    "copyIfMissing": [
      "core-zero/MASTER_INDEX.md",
      "core-zero/memories/repo/core-policies.md",
      "core-zero/memories/repo/harness-config.md",
      "core-zero/memories/repo/learned-heuristics.md",
      "core-zero/memories/repo/project-knowledge-base.md",
      "core-zero/memories/repo/adr-log.md",
      "core-zero/project/architecture.md",
      "core-zero/project/tech-stack.md",
      "core-zero/project/product-sense.md",
      "core-zero/project/project-constraints.md",
      "core-zero/project/glossary.md",
      "core-zero/project/harness-config.yaml",
      "core-zero/project/tool-providers.md",
      "core-zero/project/providers/**",
      "artifacts/features/README.md",
      "core-zero/memories/domain/**",
      "core-zero/memories/archive/deprecated-heuristics.md"
    ]
  }
}
